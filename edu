namespace TestSCVR.Models;

/// <summary>
/// Data captured on the "Education &amp; Background" step of the survey application.
/// </summary>
public class EducationBackgroundModel
{
    // ---------- Student status ----------
    /// <summary>Whether the applicant is currently a student. Gates <see cref="CurrentTrack"/>
    /// and <see cref="ProjectedGraduation"/> — both are only selectable when this is true.</summary>
    public bool? IsStudent { get; set; }

    /// <summary>One of "Certificate or Occupational degree", "High school diploma", "GED".
    /// Only meaningful/selectable when <see cref="IsStudent"/> is true.</summary>
    public string? CurrentTrack { get; set; }

    /// <summary>Only meaningful/selectable when <see cref="IsStudent"/> is true.</summary>
    public DateTime? ProjectedGraduation { get; set; }

    // ---------- Disability ----------
    /// <summary>One of the "Student with a Disability" options (0-3), matching the WinForms dropdown.</summary>
    public string? StudentWithDisability { get; set; }

    // ---------- Barriers to employment ----------
    /// <summary>"Yes", "No", or "Barrier to Employment Information Unknown".</summary>
    public string? ExOffenderStatus { get; set; }

    /// <summary>Only fillable when <see cref="ExOffenderStatus"/> is "Yes".</summary>
    public string? OffenderCharges { get; set; }

    // ---------- Impairment ----------
    public string? ImpairmentDescription { get; set; }
}
